                sidebar.classList.add('hidden');
                selectSelect.disabled = true;
                selectSelect.classList.add('opacity-50', 'cursor-not-allowed');
            }
        }

        // EXPORT TO EXCEL WITH STYLES
        function exportToExcel() {
            const selectedVal = document.getElementById('print-section-select').value;
            let sectionsToExport = cqi35Data;

            if (selectedVal !== 'all') {
                const secIdx = parseInt(selectedVal);
                sectionsToExport = [cqi35Data[secIdx]];
            }

            const wb = XLSX.utils.book_new();

            const thinBorder = {
                top: { style: "thin", color: { rgb: "CBD5E1" } },
                bottom: { style: "thin", color: { rgb: "CBD5E1" } },
                left: { style: "thin", color: { rgb: "CBD5E1" } },
                right: { style: "thin", color: { rgb: "CBD5E1" } }
            };

            const headerStyle = {
                font: { name: "Inter", sz: 10, bold: true, color: { rgb: "FFFFFF" } },
                fill: { fgColor: { rgb: "1E3A8A" } },
                alignment: { horizontal: "center", vertical: "center", wrapText: true },
                border: thinBorder
            };

            const subHeaderStyle = {
                font: { name: "Inter", sz: 10, bold: true, color: { rgb: "FFFFFF" } },
                fill: { fgColor: { rgb: "0F172A" } },
                alignment: { horizontal: "center", vertical: "center" },
                border: thinBorder
            };

            const dataStyleCell = {
                font: { name: "Inter", sz: 9 },
                alignment: { horizontal: "center", vertical: "center" },
                border: thinBorder
            };

            const textDataStyleCell = {
                font: { name: "Inter", sz: 9 },
                alignment: { horizontal: "left", vertical: "center", wrapText: true },
                border: thinBorder
            };

            const neStyleCell = {
                font: { name: "Inter", sz: 9, bold: true, color: { rgb: "B91C1C" } },
                alignment: { horizontal: "center", vertical: "center" },
                fill: { fgColor: { rgb: "FEF2F2" } },
                border: thinBorder
            };

            const complianceBoxStyle = {
                font: { name: "Inter", sz: 10, bold: true, color: { rgb: "FFFFFF" } },
                fill: { fgColor: { rgb: "1E3A8A" } },
                alignment: { horizontal: "center", vertical: "center" },
                border: thinBorder
            };

            // 1. Compliance Sheet Generation
            const compRows = [];
            const merges = [];
            let currentRowIdx = 0;

            sectionsToExport.forEach((sec) => {
                const globalIndex = cqi35Data.findIndex(s => s.code === sec.code);
                const res = sectionResults[globalIndex];
                const qList = sec.questions;

                const titleCell = {
                    v: `${sec.code}. ${sec.title.replace(/^SECTION \d+\.\s*/, '')} (Ep${globalIndex + 1} = ${res.en.toFixed(0)}%)`,
                    s: { font: { name: "Inter", sz: 11, bold: true, color: { rgb: "1E3A8A" } }, alignment: { horizontal: "left" } }
                };
                compRows.push([titleCell]);
                currentRowIdx++;

                const rowHeader = [
                    { v: "Reference", s: headerStyle }
                ];
                qList.forEach(q => rowHeader.push({ v: q.ref, s: headerStyle }));
                rowHeader.push({ v: "Value", s: subHeaderStyle });
                rowHeader.push({ v: "Max Val", s: subHeaderStyle });
                rowHeader.push({ v: "Compliance", s: subHeaderStyle });
                compRows.push(rowHeader);
                currentRowIdx++;

                const rowVal = [
                    { v: "Note / Score", s: { font: { name: "Inter", sz: 9, bold: true }, alignment: { horizontal: "center", vertical: "center" }, border: thinBorder } }
                ];
                qList.forEach(q => {
                    const sc = auditScores[q.ref].score;
                    if (sc === 'N/A') {
                        rowVal.push({ v: "n.e.", s: neStyleCell });
                    } else {
                        rowVal.push({ v: sc, s: dataStyleCell });
                    }
                });

                rowVal.push({ v: res.earned, s: { font: { name: "Inter", sz: 10, bold: true }, alignment: { horizontal: "center", vertical: "center" }, border: thinBorder } });
                rowVal.push({ v: res.max, s: { font: { name: "Inter", sz: 10, bold: true }, alignment: { horizontal: "center", vertical: "center" }, border: thinBorder } });
                rowVal.push({ v: `Ep${globalIndex + 1} ${res.en.toFixed(0)}%`, s: complianceBoxStyle });

                compRows.push(rowVal);
                currentRowIdx++;

                compRows.push([]);
                currentRowIdx++;
            });

            const wsComp = XLSX.utils.aoa_to_sheet(compRows);
            wsComp['!merges'] = merges;

            const colWidths = [{ wch: 15 }];
            let maxCols = 0;
            sectionsToExport.forEach(s => { if (s.questions.length > maxCols) maxCols = s.questions.length; });
            for (let i = 0; i < maxCols; i++) colWidths.push({ wch: 8 });
            colWidths.push({ wch: 10 }, { wch: 10 }, { wch: 16 });
            wsComp['!cols'] = colWidths;

            XLSX.utils.book_append_sheet(wb, wsComp, "Compliance Summary");

            // 2. Audit Details Sheet Generation
            const auditRows = [
                [
                    { v: "Section", s: headerStyle },
                    { v: "Reference", s: headerStyle },
                    { v: "Requirement Description", s: headerStyle },
                    { v: "Score", s: headerStyle },
                    { v: "Finding / Audited Evidence", s: headerStyle }
                ]
            ];

            sectionsToExport.forEach(sec => {
                sec.questions.forEach(q => {
                    const sc = auditScores[q.ref].score;
                    auditRows.push([
                        { v: sec.code, s: dataStyleCell },
                        { v: q.ref, s: { font: { name: "Inter", sz: 9, bold: true }, alignment: { horizontal: "center", vertical: "center" }, border: thinBorder } },
                        { v: q.text, s: textDataStyleCell },
                        { v: sc === 'N/A' ? 'N/A' : sc, s: sc === 'N/A' ? neStyleCell : dataStyleCell },
                        { v: auditScores[q.ref].finding, s: textDataStyleCell }
                    ]);
                });
            });

            const wsAudit = XLSX.utils.aoa_to_sheet(auditRows);
            wsAudit['!cols'] = [
                { wch: 15 },
                { wch: 12 },
                { wch: 55 },
                { wch: 10 },
                { wch: 45 }
            ];

            XLSX.utils.book_append_sheet(wb, wsAudit, "Audit Data Details");

            const fileName = (selectedVal === 'all')
                ? `CQI35_Full_Assessment_${document.getElementById('audit-date').value}.xlsx`
                : `CQI35_${sectionsToExport[0].code.replace(/\s+/g, '_')}_${document.getElementById('audit-date').value}.xlsx`;

            XLSX.writeFile(wb, fileName);
        }

        // SAVE LOCALSTORAGE
        function saveDataLocally() {
            const state = {
                auditor: document.getElementById('auditor-name').value,
                date: document.getElementById('audit-date').value,
                scores: auditScores,
                pdca: pdcaData
            };
            localStorage.setItem('cqi35_audit_state', JSON.stringify(state));

            const msg = document.getElementById('save-status-msg');
            if (msg) {
                msg.classList.remove('hidden');
                setTimeout(() => msg.classList.add('hidden'), 2000);
            }
        }

        // SAVE FILE TO DISK VIA BROWSER SYSTEM DIALOG
        async function saveToFileSystem() {
            saveDataLocally();
            const stateData = {
                auditor: document.getElementById('auditor-name').value,
                date: document.getElementById('audit-date').value,
                scores: auditScores,
                pdca: pdcaData
            };
            const jsonString = JSON.stringify(stateData, null, 2);
            const fileName = `CQI35_Assessment_${stateData.date}.json`;

            if ('showSaveFilePicker' in window) {
                try {
                    const handle = await window.showSaveFilePicker({
                        suggestedName: fileName,
                        types: [{
                            description: 'Fichier d\'évaluation CQI-35 JSON',
                            accept: { 'application/json': ['.json'] },
                        }],
                    });
                    const writable = await handle.createWritable();
                    await writable.write(jsonString);
                    await writable.close();
                    alert('Fichier d\'évaluation sauvegardé avec succès sur le disque !');
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        console.error('Erreur lors de la sauvegarde:', err);
                        fallbackDownload(jsonString, fileName);
                    }
                }
            } else {
                fallbackDownload(jsonString, fileName);
            }
        }

        function fallbackDownload(content, filename) {
            const blob = new Blob([content], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // OPEN FILE FROM DISK
        async function openFromFileSystem() {
            if ('showOpenFilePicker' in window) {
                try {
                    const [handle] = await window.showOpenFilePicker({
                        types: [{
                            description: 'Fichier d\'évaluation CQI-35 JSON',
                            accept: { 'application/json': ['.json'] },
                        }],
                        multiple: false
                    });
                    const file = await handle.getFile();
                    const text = await file.text();
                    applyLoadedJSON(text);
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        console.error('Erreur ouverture fichier:', err);
                    }
                }
            } else {
                const input = document.createElement('input');
                input.type = 'file';
                input.accept = '.json';
                input.onchange = e => {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = readerEvent => {
                            applyLoadedJSON(readerEvent.target.result);
                        };
                        reader.readAsText(file);
                    }
                };
                input.click();
            }
        }

        function applyLoadedJSON(jsonText) {
            try {
                const parsed = JSON.parse(jsonText);
                if (parsed.auditor) document.getElementById('auditor-name').value = parsed.auditor;
                if (parsed.date) document.getElementById('audit-date').value = parsed.date;
                if (parsed.scores) {
                    Object.keys(parsed.scores).forEach(k => {
                        if (auditScores[k]) auditScores[k] = parsed.scores[k];
                    });
                }
                if (parsed.pdca) {
                    Object.keys(parsed.pdca).forEach(k => {
                        if (pdcaData[k]) pdcaData[k] = parsed.pdca[k];
                    });
                }
                saveDataLocally();
                renderAuditDataEntryAllSections();
                calculateScores();
                renderComplianceLevelVdaStyle();
                renderPDCATable();
                alert('Données d\'évaluation chargées avec succès !');
            } catch (e) {
                alert('Erreur lors de la lecture du fichier JSON : format invalide.');
            }
        }

        // PRINT / PDF LOGIC
        function printOrSavePDF() {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('print-active'));
            document.querySelectorAll('.card-section').forEach(el => el.classList.remove('print-hidden'));

            const activeTabEl = document.getElementById(`tab-${currentTab}`);
            if (activeTabEl) activeTabEl.classList.add('print-active');

            if (currentTab === 'audit') {
                const selectedVal = document.getElementById('print-section-select').value;
                if (selectedVal !== 'all') {
                    const secIdx = parseInt(selectedVal);
                    cqi35Data.forEach((_, idx) => {
                        const secEl = document.getElementById(`sec-anchor-${idx}`);
                        if (secEl && idx !== secIdx) {
                            secEl.classList.add('print-hidden');
                        }
                    });
                }
            }

            window.print();
        }
    </script>
