        // CALCULATIONS
        let globalEG = 100.0;
        let sectionResults = [];

        function calculateScores() {
            let totalEarned = 0;
            let totalMax = 0;
            sectionResults = [];
            let devCount = 0;

            cqi35Data.forEach(sec => {
                let secEarned = 0;
                let secMax = 0;

                sec.questions.forEach(q => {
                    const sc = auditScores[q.ref].score;
                    if (sc !== 'N/A') {
                        secEarned += sc;
                        secMax += 10;
                        if (sc < 10) devCount++;
                    }
                });

                const secEn = (secMax > 0) ? (secEarned / secMax) * 100 : 100.0;
                sectionResults.push({
                    code: sec.code,
                    title: sec.title,
                    earned: secEarned,
                    max: secMax,
                    en: secEn
                });

                totalEarned += secEarned;
                totalMax += secMax;
            });

            globalEG = (totalMax > 0) ? (totalEarned / totalMax) * 100 : 100.0;

            document.getElementById('header-global-score').innerText = globalEG.toFixed(1) + " %";
            document.getElementById('compliance-overall-eg').innerText = globalEG.toFixed(1) + " %";
            document.getElementById('deviation-count-badge').innerText = devCount;

            const badge = document.getElementById('header-status-badge');
            if (globalEG >= 90) {
                badge.innerText = "LEVEL A";
                badge.className = "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold px-2.5 py-0.5 rounded";
            } else if (globalEG >= 80) {
                badge.innerText = "LEVEL B";
                badge.className = "bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold px-2.5 py-0.5 rounded";
            } else {
                badge.innerText = "LEVEL C";
                badge.className = "bg-red-500/20 text-red-300 border border-red-500/30 text-xs font-bold px-2.5 py-0.5 rounded";
            }
        }

